# Full Throttle Caddyfile — base config.
#
# Per-client subdomain blocks are dropped into /etc/full-throttle/caddy.d/<slug>.caddy
# by promote_client.sh; this file just imports them. One wildcard A record
# (*.hooks.<domain> → droplet IP) covers DNS; Caddy auto-provisions per-subdomain
# certs via HTTP-01 as each client is promoted.

{
	# Optional: add `email you@your-real-domain.com` for Let's Encrypt expiry
	# notifications. DO NOT use example.com — LE rejects it as forbidden.
	# Caddy works fine with no email set.
	#
	# For cert-debugging, uncomment the staging CA (high rate limits, no real trust):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Per-client subdomain blocks land here.
import /etc/full-throttle/caddy.d/*.caddy
