# Caddy fragment for the admin dashboard subdomain.
#
# The deploy step (see infra/README.md § "Deploy admin dashboard") copies this
# to /etc/full-throttle/caddy.d/aggregator-admin.caddy and substitutes:
#   - {{ADMIN_DOMAIN}}        → e.g. admin.fullthrottle.io  or  admin.<ip>.nip.io
#   - {{ADMIN_PASSWORD_HASH}} → contents of /etc/full-throttle/.admin-password.hash
#                               (generated by install_server.sh's step_admin_password)
#
# DNS: an A record {{ADMIN_DOMAIN}} → droplet IP must already exist.

{{ADMIN_DOMAIN}} {
	# /healthz answered directly by Caddy so liveness probes don't hit Python
	# and don't fall through to the SPA's try_files fallback.
	handle /healthz {
		respond "ok" 200
	}

	# All admin endpoints are basicauth-gated. The aggregator binds only
	# 127.0.0.1, so this is the only path that can reach it.
	handle /api/admin/* {
		basic_auth {
			admin {{ADMIN_PASSWORD_HASH}}
		}
		reverse_proxy 127.0.0.1:9201
	}

	# SPA root + try_files for client-side routing.
	# Vite emits a static dist/ that we publish from the platform repo.
	handle {
		root * /srv/full-throttle-platform/dashboards/admin/dist
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 1MB
	}

	log {
		output file /var/log/full-throttle/admin-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
